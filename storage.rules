rules_version = '2';

// Pink Wardrobe — Storage security rules.
//
// There are NO public URLs in this bucket. Every read is authenticated and
// owner-scoped. Clients fetch images through the Firebase SDK (which attaches
// the auth token); getDownloadURL tokens are never shared outside the owner.
//
// Outfit images sent in chat are the one cross-user read: the recipient needs
// to see the outfit card. Those are copied into a dedicated `shared/` path at
// send time rather than exposing the sender's private layer directory.

service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Reject anything that isn't an image, and cap upload size. Clients
    // compress before upload, so 8MB is generous headroom.
    function isImageUnder8MB() {
      return request.resource.contentType.matches('image/.*')
             && request.resource.size < 8 * 1024 * 1024;
    }

    // -----------------------------------------------------------------
    // Private per-user storage: avatar, raw garment photos, FASHN outputs,
    // segmented cutouts, aligned layers, composited combos.
    // -----------------------------------------------------------------
    match /users/{uid}/{allPaths=**} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid) && isImageUnder8MB();
      allow delete: if isOwner(uid);
    }

    // -----------------------------------------------------------------
    // Outfits shared into a chat. Readable by both participants of the
    // conversation named in the path; writable only by the sender.
    // -----------------------------------------------------------------
    match /shared/{conversationId}/{senderId}/{fileName} {
      allow read: if signedIn()
                  && firestore.get(/databases/(default)/documents/conversations/$(conversationId))
                       .data.participants.hasAny([request.auth.uid]);
      allow write: if isOwner(senderId) && isImageUnder8MB();
      allow delete: if isOwner(senderId);
    }

    // Everything else is denied.
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
