# ---------------------------------------------------------------------------
# CLIENT — safe to ship in the browser bundle and the APK.
#
# Copy this file to web/.env.local and fill in from your Supabase dashboard
# (Project Settings > API).
#
# The anon key is designed to be public. Row Level Security is what protects
# your data, not the secrecy of this key.
# ---------------------------------------------------------------------------

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=

# Optional. Without it, weather-aware suggestions quietly turn off.
VITE_OPENWEATHER_API_KEY=


# ---------------------------------------------------------------------------
# SERVER — never put these in web/.env.local, and never reference them from
# anything under web/src/. They are set in the Supabase dashboard under
# Edge Functions > Secrets, and read there via Deno.env.get().
#
#   FASHN_API_KEY            your FASHN.ai key. The only paid call in the app.
#   PURGE_SECRET             any long random string; authenticates the
#                            scheduled recycle-bin purge.
#
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected into Edge Functions
# automatically — do not set them yourself.
#
# If any of these ever appears in a VITE_ variable, it is exposed to anyone who
# downloads the app. There is no way to hide it after that; rotate it.
# ---------------------------------------------------------------------------
