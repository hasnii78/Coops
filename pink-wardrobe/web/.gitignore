# MediaPipe models and WASM runtime are fetched/copied at build time by
# scripts/fetch-models.mjs. They are ~55MB of binary and do not belong in git.
public/mediapipe/

# Capacitor generates the native project from capacitor.config.json on every
# build, so the platform folder is disposable.
android/
ios/

